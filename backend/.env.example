# PostgreSQL connection string (Render Postgres, Supabase, local, etc.)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/mini_social_feed?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# CORS - comma-separated list of allowed origins (mobile app / web clients), or * for all
CORS_ORIGIN="*"

# Firebase Admin SDK (for FCM push notifications)
# Generate a service account key from Firebase Console > Project Settings > Service Accounts
# Paste the full JSON as a single-line string, OR set FIREBASE_SERVICE_ACCOUNT_PATH to a file path.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
